{
  "document_mode": "thesis",
  "thesis_mode_enabled": true,
  "enable_thesis_structure_detection": true,
  "enable_first_line_indent": true,
  "first_line_indent_chars": 2.0,
  "first_line_indent_tolerance_chars": 0.2,
  "first_line_indent_scope": "body_only",
  "enable_format_report": true,
  "report_level": "normal",
  "protect_toc": true,
  "protect_references": true,
  "protect_captions": true,
  "protect_equations": true,
  "protect_table_text": true,
  "enable_caption_number_audit": true,
  "enable_cross_reference_audit": true,
  "caption_search_window": 3,
  "caption_numbering_mode": "auto",
  "allow_subfigure_suffix": true,
  "warn_unreferenced_captions": false,
  "ui_scale": 1.0,
  "remember_window_geometry": true
}
